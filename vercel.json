{
  "cleanUrls": true,
  "functions": {
    "api/cerca.js": { "maxDuration": 60 },
    "api/pair.js": { "maxDuration": 15 }
  },
  "headers": [
    { "source": "/.well-known/meta-wearables-manifest.json", "headers": [ { "key": "Content-Type", "value": "application/json; charset=utf-8" }, { "key": "Access-Control-Allow-Origin", "value": "*" } ] },
    { "source": "/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
